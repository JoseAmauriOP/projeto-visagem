[node name="HowToText" type="RichTextLabel" parent="HowToOverlay/CenterContainer/PanelContainer/VBoxContainer" unique_id=1773815287]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
bbcode_enabled = true
text = "Uma visagem está assombrando a vila. Descubra qual delas é a culpada antes que o sol nasça.

[b]Investigue:[/b] a cada noite, escolha um local da vila. A pista revela se a visagem tem ou não aquela característica.

[b]Deduza:[/b] clique nas suspeitas para riscar as que não combinam com as pistas.

[b]Acuse:[/b] você pode acusar a qualquer momento. Depois da terceira noite, a acusação é obrigatória.

Acerte, e a vila volta a ter paz. Erre, e a visagem vence."
fit_content = true

